{
  "comment": "Which repositories release through the shared signing, and what their `release` environment holds. Names only: values live in the Observatory vault and reach GitHub through scripts/sync-release-secrets.py. Design: docs/release-signing/DESIGN.md.",
  "environment": "release",
  "team": "release-approvers",
  "tag_pattern": "v*",
  "prevent_self_review": false,
  "groups": {
    "apple": [
      "APPLE_DEVELOPER_ID_P12_B64",
      "APPLE_DEVELOPER_ID_P12_PASSWORD",
      "ASC_API_KEY_P8_B64",
      "ASC_KEY_ID",
      "ASC_ISSUER_ID"
    ],
    "mas": [
      "APPLE_DISTRIBUTION_P12_B64",
      "APPLE_INSTALLER_P12_B64",
      "APPLE_MAS_P12_PASSWORD",
      "MAS_PROVISION_PROFILE_B64"
    ],
    "gpg": [
      "RELEASE_GPG_PRIVATE_KEY_B64",
      "RELEASE_GPG_PASSPHRASE"
    ],
    "android": [
      "ANDROID_KEYSTORE_B64",
      "ANDROID_KEYSTORE_PASSWORD",
      "ANDROID_KEY_ALIAS",
      "ANDROID_KEY_PASSWORD"
    ]
  },
  "azure_signing": {
    "comment": "Windows Authenticode for every product that ships for Windows (fabric-workspace knowledge/platforms.md PL-03): one Azure Artifact Signing account and Public Trust certificate profile; each repository signs in with its own app registration, whose only federated credential is repo:<repo>:environment:release and whose only role is `role` on this account. scripts/setup-windows-signing.py makes that identity; setup-release-env.py sets the account's variables on every repository with \"windows\": true. Tenant and subscription are read from the operator's az session, never written here. The profile was created with includeStreetAddress and includePostalCode false: keep them false on a new profile.",
    "resource_group": "rg-passioncode-signing",
    "account": "passioncodesigning",
    "endpoint": "https://neu.codesigning.azure.net/",
    "certificate_profile": "passioncode-public-trust",
    "role": "Artifact Signing Certificate Profile Signer",
    "app_prefix": "github-release-signing-"
  },
  "repos": {
    "passioncode-ai/project-observatory-dashboard": {
      "groups": [
        "apple",
        "gpg"
      ],
      "vars": {
        "APPLE_TEAM_ID": "KJ35UYYL22",
        "AZURE_SIGNING_ENABLED": "false"
      },
      "windows": true
    },
    "passioncode-ai/fabric-dashboards": {
      "groups": [
        "apple",
        "gpg"
      ],
      "vars": {
        "APPLE_TEAM_ID": "KJ35UYYL22",
        "AZURE_SIGNING_ENABLED": "true"
      },
      "windows": true
    },
    "passioncode-ai/fabric-inbox": {
      "groups": [
        "apple",
        "mas",
        "gpg"
      ],
      "vars": {
        "APPLE_TEAM_ID": "KJ35UYYL22",
        "AZURE_SIGNING_ENABLED": "false"
      },
      "windows": true
    },
    "passioncode-ai/fabric": {
      "groups": [
        "apple",
        "gpg"
      ],
      "vars": {
        "APPLE_TEAM_ID": "KJ35UYYL22",
        "AZURE_SIGNING_ENABLED": "false"
      },
      "windows": true
    },
    "passioncode-ai/fabric-switchboard": {
      "groups": [
        "apple",
        "gpg"
      ],
      "vars": {
        "APPLE_TEAM_ID": "KJ35UYYL22",
        "AZURE_SIGNING_ENABLED": "true"
      },
      "windows": true
    },
    "passioncode-ai/fabric-vr": {
      "groups": [
        "android",
        "gpg"
      ],
      "vars": {}
    }
  }
}
